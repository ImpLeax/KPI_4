{
  "info": {
    "name": "Upcycling Ideas API",
    "description": "Requests for every endpoint of the upcycling recommendation API (see server/docs/openapi.yaml). Run against a freshly reset database (npm run db:reset): expected ids come from server/db/SEED_NOTES.md. The \"Ideas - write\" folder creates, updates and deletes its own idea, so it can be re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdIdeaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dictionaries",
      "item": [
        {
          "name": "Materials (uk, default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/materials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "materials"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('30 materials with id, name, category', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.lengthOf(30);",
                  "  body.forEach((m) => pm.expect(m).to.have.all.keys('id', 'name', 'category'));",
                  "});",
                  "pm.test('Ukrainian names', () => pm.expect(pm.response.json().find((m) => m.id === 8).name).to.eql('Скляна банка'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Materials (en)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/materials?lang=en",
              "host": ["{{baseUrl}}"],
              "path": ["api", "materials"],
              "query": [
                {
                  "key": "lang",
                  "value": "en"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('English names', () => pm.expect(pm.response.json().find((m) => m.id === 8).name).to.eql('Glass jar'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Materials - invalid lang (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/materials?lang=de",
