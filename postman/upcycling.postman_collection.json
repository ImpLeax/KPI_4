          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('title falls back to the submitted language', () => pm.expect(pm.response.json().title).to.eql('Postman bottle lantern'));"
                ]
              }
            }
          ]
        },
