    {
      "name": "Ideas - write",
      "item": [
        {
          "name": "Create idea (201)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ideas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ideas"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "lang",
                  "value": "en",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Postman bottle lantern",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Created from the Postman collection.",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "decor",
                  "type": "text"
                },
                {
                  "key": "difficulty",
                  "value": "easy",
                  "type": "text"
                },
                {
                  "key": "estimatedTime",
                  "value": "25",
                  "type": "text"
                },
                {
                  "key": "materials",
                  "value": "[{\"materialId\":1,\"isRequired\":true,\"quantity\":\"1 pc\"},{\"materialId\":22,\"isRequired\":false}]",
                  "type": "text"
                },
                {
                  "key": "tools",
                  "value": "[1,3]",
                  "type": "text"
                },
                {
                  "key": "steps",
                  "value": "[\"Cut the bottle in half\",\"Paint the outside\"]",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": "public/images/seed/bottle-bird-feeder.jpg"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location header points at the new idea', () => {",
                  "  const idea = pm.response.json();",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql(`/api/ideas/${idea.id}`);",
                  "  pm.expect(idea.title).to.eql('Postman bottle lantern');",
                  "  pm.expect(idea.photoUrl).to.match(/^\\/uploads\\/.+\\.jpg$/);",
                  "  pm.collectionVariables.set('createdIdeaId', idea.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Created idea in uk (falls back to en)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ideas/{{createdIdeaId}}?lang=uk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ideas", "{{createdIdeaId}}"],
              "query": [
                {
                  "key": "lang",
                  "value": "uk"
                }
