{
  "name": "upcycling-app",
  "version": "1.0.0",
  "description": "Upcycling ideas recommendation system (KPI, TV-42, variant 15)",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "npm run build:css",
    "start": "node server/index.js",
    "predev": "npm run build:css",
    "dev": "concurrently -k -n server,css -c green,cyan \"node --watch-path=server server/index.js\" \"npm:watch:css\"",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/styles.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/css/styles.css --watch",
    "db:reset": "node server/db/reset.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "better-sqlite3@13.0.3": true
  }
}
